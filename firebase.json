{
  "emulators": {
    "auth": { "port": 9099, "host": "localhost" },
    "firestore": { "port": 8080, "host": "localhost" },
    "functions": { "port": 5001, "host": "localhost" },
    "ui": { "enabled": true, "port": 4000 }
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs22",
    "ignore": ["node_modules", ".git", "firebase-debug.log"]
  },
  "hosting": {
    "public": "dist",
    "rewrites": [
      {
        "source": "/todoist-oauth-callback",
        "function": "exchangeToken"
      }
    ],
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"]
  }
}